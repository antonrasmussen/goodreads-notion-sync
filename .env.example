# Notion internal integration token (Settings → Integrations).
# Share both databases with the integration.
NOTION_TOKEN=

# Created for this project:

NOTION_LIBRARY_DATABASE_ID=

# 2026 physical reading list:

NOTION_READING_LIST_DATABASE_ID=

GOODREADS_USER_ID=

# Only needed if the Goodreads profile/RSS is private.
# GOODREADS_RSS_KEY=

# Year used to mark 2026-list Status=Completed (date-read in this year).
READING_YEAR=2026

# Fuzzy title match threshold (0-100) when Goodreads ID is not stored yet.
MATCH_THRESHOLD=90
